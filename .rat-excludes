#
# Apache RAT excludes for the packaged source release (cloudstore-<version>-src.tar.gz).
# Ships at the archive root so a RAT scan of the extracted source release --
# whether run by ATR or by hand -- picks up the same exclusions as this
# project's own build (see pom.xml's apache-rat-plugin inputExcludes, which
# this list is kept in step with by hand).
.git/
.idea/
.*\.iml
.*\.DS_Store
pom.xml.versionsBackup
.gitignore
src/main/resources/cloudstore/required.txt
src/main/resources/META-INF/MANIFEST.MF
src/test/resources/auth-keys.xml
src/test/resources/TestAuditLogs/.*
dev-support/eclipse-formatter.xml
NOTICE.*
