<!--
  Local/fork path for the release's mandatory source artifact: packages the
  working directory via Maven, filesystem excludes rather than
  `git ls-files`, so it works from a shallow clone, a fork, or a directory
  that isn't a git checkout at all.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>src</id>
  <formats>
    <format>tar.gz</format>
  </formats>
  <includeBaseDirectory>true</includeBaseDirectory>
  <baseDirectory>${project.artifactId}-${project.version}-src</baseDirectory>
  <fileSets>
    <fileSet>
      <directory>${project.basedir}</directory>
      <useDefaultExcludes>true</useDefaultExcludes>
      <excludes>
        <exclude>target/**</exclude>
        <exclude>**/target/**</exclude>
        <exclude>.git/**</exclude>
        <exclude>.idea/**</exclude>
        <!-- Local AI-assistant tooling state; untracked, not part of the
             project's source (see AGENTS.MD / CLAUDE.md for the tracked
             instructions files, which are not excluded here). -->
        <exclude>.claude/**</exclude>
        <exclude>**/*.iml</exclude>
        <exclude>**/.DS_Store</exclude>
        <exclude>pom.xml.versionsBackup</exclude>
        <exclude>src/test/resources/auth-keys.xml</exclude>
      </excludes>
    </fileSet>
  </fileSets>
</assembly>
